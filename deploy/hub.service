[Unit]
Description=compute-commons hub
After=network.target

[Service]
Type=simple
User=compute-commons
WorkingDirectory=/opt/compute-commons/hub
ExecStart=/opt/compute-commons/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# only reachable via nginx on localhost -- never expose port 8000 directly to the internet
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
